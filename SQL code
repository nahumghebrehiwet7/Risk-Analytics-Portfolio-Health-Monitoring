# Delinquency by loan intent
select
loan_purpose,
count(loan_id) as Total,
count(case when is_delinquent = 'True' then loan_id end) as Delinquent_Count,
count(case when is_delinquent = 'False' then loan_id end) as Non_delinquent_Count,
(count(case when is_delinquent = 'True' then loan_id end)/count(loan_id)) as Percentage_Delinquent
from loan_master
group by loan_purpose
order by Percentage_delinquent desc;

# Delinquency by FICO band 
select
a.fico_band,
count(loan_id) as Total,
count(case when is_delinquent = 'True' then loan_id end) as Delinquent_Count,
count(case when is_delinquent = 'False' then loan_id end) as Non_delinquent_Count,
(count(case when is_delinquent = 'True' then loan_id end)/count(loan_id)) as Percentage_Delinquent
from borrower_demographics a
left join loan_master b on a.borrower_id=b.borrower_id
group by fico_band
order by Percentage_Delinquent;

# Delinquency by age group
select 
case
when age = 19 then "19 years old"
when age < 30 and age > 19 then "20-29 years"
when age < 45 and age >= 30 then "30-44 years"
when age < 60 and age >= 45 then "45-59 years"
else "60+ years"
end as age_group,
count(case when is_delinquent = "True" then loan_id end) as delinquent_count,
count(case when is_delinquent = "False" then loan_id end) as non_delinquent_count,
count(is_delinquent),
(count(case when is_delinquent = "True" then loan_id end)/count(is_delinquent)) as delinquent_percentage
from borrower_demographics a
join loan_master b
on a.borrower_id=b.borrower_id
group by age_group
order by delinquent_percentage desc;

# Delinquency by Income and Loan to Debt Ratio
select
case
when annual_income < 40000 then 'Below $40,000'
when annual_income >= 40000 and annual_income < 60000 then '$40,000-$60,000'
when annual_income >= 60000 and annual_income < 100000 then '$60,000-$100,000'
else 'Above $100,000'
end as income_bracket,
case
when dti_ratio < 20 then "Below 20%"
when dti_ratio >= 20 and dti_ratio < 30 then "20-30%"
when dti_ratio >= 30 and dti_ratio < 40 then "30-40%"
when dti_ratio >= 40 and dti_ratio < 50 then "40-50%"
else "Above 50%"
end as Loan_To_Debt_Ratio,
count(case when is_delinquent = "true" then loan_id end) as Delinquent_Count,
count(case when is_delinquent = "false" then loan_id end) as Non_Delinquent_Count,
count(a.borrower_id) as Count,
(count(case when is_delinquent = "true" then loan_id end)/count(a.borrower_id)) as Delinquency_Percentage
from borrower_demographics a

# Delinquency by income and LTD v2
select
case
when annual_income < 40000 then 'Below $40,000'
when annual_income >= 40000 and annual_income < 60000 then '$40,000-$60,000'
when annual_income >= 60000 and annual_income < 100000 then '$60,000-$100,000'
else 'Above $100,000'
end as income_bracket,
case
when dti_ratio < 25 then "Below 25%"
when dti_ratio >= 25 and dti_ratio < 35 then "25-35%"
when dti_ratio >= 35 and dti_ratio < 45 then "30-45%"
else "Above 45%"
end as Loan_To_Debt_Ratio,
count(case when is_delinquent = "true" then loan_id end) as Delinquent_Count,
count(case when is_delinquent = "false" then loan_id end) as Non_Delinquent_Count,
count(a.borrower_id) as Count,
(count(case when is_delinquent = "true" then loan_id end)/count(a.borrower_id)) as Delinquency_Percentage
from borrower_demographics a
join loan_master b
on a.borrower_id = b.borrower_id
group by income_bracket, Loan_To_Debt_Ratio
order by Delinquency_Percentage  desc;

# Delinquency by State
select
origination_state,
(count(case when is_delinquent = 'True' then loan_id end)) as delinquent_count,
(count(case when is_delinquent = 'false' then loan_id end)) as non_delinquent_count,
count(loan_id),
(count(case when is_delinquent = 'True' then loan_id end)/count(loan_id)) as delinquent_percentage
from loan_master
group by origination_state
order by count(loan_id) asc; 
join loan_master b
on a.borrower_id = b.borrower_id
group by income_bracket, Loan_To_Debt_Ratio
order by Delinquency_Percentage  desc;
